.cf input:focus,.cf textarea:focus{outline:none;border-color:rgba(139,123,255,.6);box-shadow:0 0 0 3px rgba(139,123,255,.18),0 0 20px rgba(139,123,255,.12)}.cf button{justify-self:start;cursor:pointer;font:inherit;font-weight:600}.cf+.btns{margin-top:28px}
