body{margin:0;font:16px/1.65 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--text);background:radial-gradient(1000px 620px at 88% -6%,rgba(139,123,255,.20),transparent 62%),radial-gradient(820px 520px at -8% 16%,rgba(78,163,255,.15),transparent 60%),radial-gradient(900px 720px at 96% 52%,rgba(139,123,255,.10),transparent 62%),radial-gradient(760px 560px at 4% 88%,rgba(78,163,255,.10),transparent 60%),linear-gradient(180deg,#0b1224,#0a0f22 50%,#0b1224)}
