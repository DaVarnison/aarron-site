.btn:hover{text-decoration:none;transform:translateY(-2px);border-color:var(--brd-hi);box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 12px 32px rgba(2,6,20,.45),0 0 24px rgba(139,123,255,.25)}
.btn:active{transform:translateY(0)}
.btn.p{background:linear-gradient(135deg,rgba(139,123,255,.5),rgba(78,163,255,.45));border:1px solid rgba(183,170,255,.45);color:#fff}
