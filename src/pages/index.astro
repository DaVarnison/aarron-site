---
const exp = [
 {role:'Director of Major Events',org:'Sentry Event Services, Inc.',dates:'Dec 2025 – Present',featured:true,pts:[
  'Oversee, coordinate and perform all major event operations company-wide.',
  'Lead Senior Managers for each major event category.',
  'Ensure operational consistency, policy compliance, accurate scheduling, and timely payroll and billing submission.',
  'Serve as key liaison between internal departments and clients.',
  'Accountable for staffing, leadership coverage and operational execution.']},
 {role:'Operations Manager',org:'Sentry Event Services, Inc. (formerly BCM Security Services, Inc.)',dates:'Jan 2025 – Dec 2025',pts:[
  'Scheduling and staffing for security and guest service teams; payroll submission.',
  'Budgeting, staffing and post-event spreadsheet analysis and reporting.',
  'Client communication, team leadership and on-site operations.',
  'Interdepartmental coordination, risk management and safety, and post-event evaluation.']},
 {role:'PA Operations Manager',org:'BCM Security Services, Inc.',dates:'Jun 2022 – Nov 2025',pts:['Same operations, staffing, payroll, reporting and client-facing duties across Pennsylvania events.']},
 {role:'Operations Coordinator',org:'BCM Security Services, Inc.',dates:'Jun 2022 – Jan 2023',pts:[]},
 {role:'Supervisor',org:'BCM Security Services, Inc.',dates:'May 2022 – Jun 2022',pts:['Supervised staff, issued and tracked breaks, and deployed staff to posts.']},
 {role:'Event Staff / Security',org:'BCM Security Services, Inc.',dates:'Jun 2021 – May 2022',pts:['Guest services and security roles including access control, crowd control, stage security and asset protection.']},
];
const earlier=[
 ['Diesel Technician','McCarthy Tire Service','Apr 2019 – Dec 2019'],
 ['Diesel Technician','Commonwealth Equipment Corp','Jun 2018 – Jan 2019'],
 ['Food Service Worker','Taco Bell','May 2017 – Apr 2018'],
 ['Johnny Rockets','','2020'],
];
const certs=['FEMA IS-242c','FEMA IS-35.25','FEMA IS-912','FEMA IS-453','PISGS Info Seminar'];
const skills=['Operational Planning','Team Leadership','Team Building','Scheduling & Staffing','Budgeting & Reporting','Risk Management & Safety','Client Communication','Cross-department Coordination'];
const FORM_KEY='6431b466-c9ba-401b-806d-010ab7ec2760';
const li='https://www.linkedin.com/in/aarron-warnagiris-695980262/';
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aarron Warnagiris — Director of Major Events &amp; Aspiring Software Engineer</title>
<meta name="description" content="Aarron Warnagiris: Director of Major Events & Special Projects at Sentry Event Services, studying Computer Software Engineering, building toward a full-stack developer career.">
<meta property="og:title" content="Aarron Warnagiris — Director of Major Events &amp; Aspiring Software Engineer">
<meta property="og:description" content="Portfolio of Aarron Warnagiris: event operations leader building toward a full-stack software engineering career.">
<meta property="og:type" content="website"><meta property="og:url" content="https://aarronwarnagiris.com/">
<meta property="og:image" content="https://aarronwarnagiris.com/images/og.jpg"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://aarronwarnagiris.com/images/og.jpg">
<meta name="theme-color" content="#0b1224">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<style>
:root{--bg:#0b1224;--bg2:#111a33;--card:#141e3a;--line:#243056;--text:#e6e9f5;--mut:#9aa6c7;--a:#8b7bff;--b:#4ea3ff}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font:16px/1.65 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--text);background:radial-gradient(900px 500px at 85% -5%,rgba(139,123,255,.18),transparent),radial-gradient(700px 400px at -5% 10%,rgba(78,163,255,.12),transparent),var(--bg)}
a{color:var(--b);text-decoration:none}a:hover{text-decoration:underline}
.w{max-width:900px;margin:0 auto;padding:0 22px}
nav{position:sticky;top:0;background:rgba(11,18,36,.85);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);z-index:5}
nav .w{display:flex;justify-content:space-between;align-items:center;height:56px}
nav b{letter-spacing:.04em}nav div a{color:var(--mut);margin-left:18px;font-size:14px}nav div a:hover{color:var(--text);text-decoration:none}
.hero{padding:96px 22px 64px}
.hl{display:flex;align-items:center;justify-content:space-between;gap:40px}
.pic{width:260px;height:260px;border-radius:50%;object-fit:cover;flex:none;border:3px solid transparent;background:linear-gradient(var(--bg),var(--bg)) padding-box,linear-gradient(135deg,var(--a),var(--b)) border-box;box-shadow:0 0 40px rgba(139,123,255,.35),0 0 80px rgba(78,163,255,.18)}
@media(max-width:700px){.hl{flex-direction:column-reverse;align-items:flex-start;gap:24px}.pic{width:160px;height:160px}}
.hero h1{font-size:clamp(2.4rem,7vw,4rem);line-height:1.05;margin:0 0 12px;background:linear-gradient(90deg,#fff,#b7aaff 60%,#7cb8ff);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero .t{font-size:1.25rem;margin:0}.hero .m{color:var(--mut);margin:6px 0 20px}
.hero .g{max-width:620px;color:var(--text);border-left:3px solid var(--a);padding-left:14px}
.btns{margin-top:26px;display:flex;gap:12px;flex-wrap:wrap}
.btn{padding:10px 18px;border-radius:10px;border:1px solid var(--line);color:var(--text);font-weight:600}
.btn.p{background:linear-gradient(90deg,var(--a),var(--b));border:0;color:#0b1224}.btn:hover{text-decoration:none;filter:brightness(1.1)}
section{padding:56px 0;border-top:1px solid var(--line)}
h2{font-size:1.5rem;margin:0 0 24px}h2::after{content:"";display:block;width:42px;height:3px;margin-top:8px;background:linear-gradient(90deg,var(--a),var(--b));border-radius:3px}
.tl{border-left:2px solid var(--line);margin-left:6px;padding-left:24px}
.it{position:relative;margin-bottom:26px}.it::before{content:"";position:absolute;left:-31px;top:8px;width:12px;height:12px;border-radius:50%;background:var(--bg);border:2px solid var(--a)}
.it.f{background:var(--card);border:1px solid var(--a);border-radius:14px;padding:20px;box-shadow:0 0 30px rgba(139,123,255,.15)}
.it.f::before{left:-31px;top:26px;background:var(--a)}
.it h3{margin:0;font-size:1.1rem}.org{color:var(--b)}.d{color:var(--mut);font-size:.9rem}
ul{margin:8px 0 0;padding-left:20px;color:#cdd3ea}li{margin:3px 0}
.chips{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none}
.chips li{margin:0;padding:7px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--text);font-size:.95rem}
.chips.top li{border-color:var(--a)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.c{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}.c h3{margin:0 0 4px;font-size:1rem}.c p{margin:0;color:var(--mut);font-size:.92rem}
.build{margin-top:22px;padding:18px;border-radius:12px;border:1px dashed var(--a);background:rgba(139,123,255,.07)}
.cf{display:grid;gap:14px;max-width:560px}.cf label{display:grid;gap:6px;color:var(--mut);font-size:.9rem}
.cf input,.cf textarea{background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--text);padding:10px 12px;font:inherit}
.cf input:focus,.cf textarea:focus{outline:2px solid var(--a);border-color:transparent}.cf button{justify-self:start;cursor:pointer;font:inherit;font-weight:600}.cf+.btns{margin-top:28px}
details{margin-top:10px}summary{cursor:pointer;color:var(--mut)}
footer{padding:32px 0;color:var(--mut);font-size:.85rem;border-top:1px solid var(--line);text-align:center}
@media(max-width:560px){nav div a:nth-child(n+4){display:none}.hero{padding-top:56px}}
</style></head><body>
<nav><div class="w"><b>AW</b><div><a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#education">Education</a><a href="#contact">Contact</a></div></div></nav>
<header class="w hero"><div class="hl"><div class="ht">
<h1>Aarron Warnagiris</h1>
<p class="t">Director of Major Events &amp; Special Projects · Sentry Event Services, Inc.</p>
<p class="m">Wilkes-Barre, Pennsylvania</p>
<p class="g">Goal: start and maintain a career as a full-stack software engineer / developer.</p>
<div class="btns"><a class="btn p" href={li} target="_blank" rel="noopener">Connect on LinkedIn</a><a class="btn" href="#experience">View experience</a><a class="btn" href="https://varnison.com" target="_blank" rel="noopener">My creator / studio side →</a></div></div>
<img class="pic" src="images/headshot-800.jpg" srcset="images/headshot-400.jpg 400w, images/headshot-800.jpg 800w" sizes="(max-width:700px) 160px, 260px" width="260" height="260" alt="Aarron Warnagiris" fetchpriority="high">
</div></header>
<main class="w">
<section id="about"><h2>About</h2>
<p>I lead large-scale event operations as Director of Major Events &amp; Special Projects at Sentry Event Services, Inc., with a background that runs from the floor of live events up through operations management.</p>
<p>I'm constantly on the move to grow and expand my skill set, and I welcome advice. Alongside my day job I'm studying Computer Software Engineering through Coursera (since July 2025) with the goal of building a career as a full-stack software engineer.</p>
<div class="build"><b>Building</b> — games, mods, apps and websites under my creator and studio name, Varnison. <a href="https://varnison.com" target="_blank" rel="noopener">Visit varnison.com →</a></div>
</section>
<section id="experience"><h2>Experience</h2>
<div class="tl">
{exp.map(e=>(<div class={'it'+(e.featured?' f':'')}><h3>{e.role}</h3><div class="org">{e.org}</div><div class="d">{e.dates}</div>{e.pts.length>0&&<ul>{e.pts.map(p=><li>{p}</li>)}</ul>}</div>))}
</div>
<details><summary>Earlier experience</summary><div class="tl" style="margin-top:14px">
{earlier.map(e=>(<div class="it"><h3>{e[0]}{e[1]&&<span class="org"> · {e[1]}</span>}</h3><div class="d">{e[2]}</div></div>))}
</div></details>
</section>
<section id="skills"><h2>Skills</h2>
<ul class="chips top"><li>Operational Planning</li><li>Team Leadership</li><li>Team Building</li></ul>
</section>
<section id="certs"><h2>Certifications</h2>
<ul class="chips">{certs.map(c=><li>{c}</li>)}</ul></section>
<section id="education"><h2>Education</h2><div class="grid">
<div class="c"><h3>Computer Software Engineering</h3><p>Coursera · since July 2025</p></div>
<div class="c"><h3>High School Diploma</h3><p>James M. Coughlin Jr/Sr High School</p></div>
<div class="c"><h3>Diesel Mechanics Technology</h3><p>Wilkes-Barre Area Career &amp; Technical Center</p></div>
</div></section>
<section id="contact"><h2>Contact</h2>
<p>Send me a message below, or reach out on LinkedIn.</p>
<form id="cf" class="cf" action="https://api.web3forms.com/submit" method="POST">
<input type="hidden" name="access_key" value={FORM_KEY}>
<input type="hidden" name="subject" value="New message from aarronwarnagiris.com">
<input type="hidden" name="from_name" value="aarronwarnagiris.com">
<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none">
<label>Name<input name="name" required maxlength="100" autocomplete="name"></label>
<label>Email<input type="email" name="email" required maxlength="150" autocomplete="email"></label>
<label>Message<textarea name="message" required rows="5" maxlength="3000"></textarea></label>
<button class="btn p" type="submit">Send message</button>
<p id="cs" role="status" class="d"></p>
</form>
<script is:inline>
document.getElementById('cf').addEventListener('submit',async e=>{e.preventDefault();const f=e.target,s=document.getElementById('cs');s.textContent='Sending…';
try{const r=await fetch(f.action,{method:'POST',headers:{Accept:'application/json'},body:new FormData(f)});const j=await r.json();if(j.success){s.textContent='Thanks! Your message was sent.';f.reset()}else throw 0}catch(_){s.textContent='Something went wrong. Please reach out via LinkedIn instead.'}});
</script>
<div class="btns"><a class="btn" href={li} target="_blank" rel="noopener">LinkedIn</a><a class="btn" href="https://varnison.com" target="_blank" rel="noopener">varnison.com</a></div>
</section>
</main>
<footer>© {new Date().getFullYear()} Aarron Warnagiris</footer>
</body></html>
