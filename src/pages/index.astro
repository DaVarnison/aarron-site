<style>
:root{--bg:#0b1224;--text:#e9ecf7;--mut:#9aa6c7;--a:#8b7bff;--b:#4ea3ff;--glass:rgba(255,255,255,.055);--brd:rgba(255,255,255,.13);--brd-hi:rgba(255,255,255,.24);--sh:0 12px 32px rgba(2,6,20,.4);--inner:inset 0 1px 0 rgba(255,255,255,.14)}
